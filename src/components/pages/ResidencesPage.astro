---
import Hero from '../Hero.astro';
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import Button from '../Button.astro';
import ResponsiveImage from '../ResponsiveImage.astro';
import UnitExplorer from '../UnitExplorer.astro';
import { getDictionary } from '../../i18n';
import type { Locale } from '../../i18n';
import { layoutSummary } from '../../lib/units';
import { CONTACT } from '../../data/project';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const labels = dict.residences;
const summary = layoutSummary();
---

<Hero
  media="exterior/facade-front"
  alt={dict.media['exterior/facade-front']}
  eyebrow={labels.heroEyebrow}
  title={labels.heroTitle}
  lede={labels.heroLede}
/>

<Section width="wide">
  <UnitExplorer locale={locale} />
</Section>

<Section tone="sand">
  <div class="grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:gap-20">
    <div class="reveal">
      <SectionHeading title={labels.sitePlanTitle} lede={labels.sitePlanLede} />
      <p class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-gold">
        <svg width="24" height="10" viewBox="0 0 24 10" fill="none" aria-hidden="true" class="flip-rtl">
          <path d="M0 5h21M17 1l4 4-4 4" stroke="currentColor" stroke-width="1.3"></path>
        </svg>
        {labels.seaDirection}
      </p>
    </div>
    <div class="reveal overflow-hidden rounded-sm border border-sand-300 bg-white p-4 sm:p-6">
      <ResponsiveImage
        media="siteplan/vaziyet"
        alt={dict.media['siteplan/vaziyet']}
        sizes="(min-width:1024px) 55vw, 92vw"
      />
    </div>
  </div>
</Section>

<Section>
  <SectionHeading title={labels.mixTitle} lede={labels.mixLede} />
  <div class="reveal mt-12 overflow-x-auto">
    <table class="w-full min-w-[30rem] border-collapse text-start text-sm">
      <thead>
        <tr class="border-b border-deep/20 text-[0.6875rem] font-semibold tracking-[0.18em] text-muted uppercase">
          <th scope="col" class="py-4 text-start">{labels.typeColumn}</th>
          <th scope="col" class="py-4 text-start">{labels.countColumn}</th>
          <th scope="col" class="py-4 text-start">{labels.rangeColumn}</th>
        </tr>
      </thead>
      <tbody>
        {
          summary.map((row) => (
            <tr class="border-b border-sand-300">
              <th scope="row" class="py-4 text-start font-[family-name:var(--font-display)] text-xl font-normal text-deep">
                {row.layout}
              </th>
              <td class="py-4 text-muted">{row.count}</td>
              <td class="py-4 text-muted">
                {row.minArea === row.maxArea ? `${row.minArea} m²` : `${row.minArea} – ${row.maxArea} m²`}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="reveal mt-12 max-w-2xl border-s-2 border-gold/40 ps-6">
    <h3 class="text-lg text-deep">{labels.noteTitle}</h3>
    <p class="mt-2 text-sm leading-relaxed text-muted">{labels.noteBody}</p>
  </div>

  <div class="mt-12 flex flex-wrap gap-3">
    <Button href={CONTACT.whatsappHref} external>{dict.actions.whatsapp}</Button>
    <Button href={CONTACT.phoneHref} variant="ghost">{CONTACT.phoneDisplay}</Button>
  </div>
</Section>
