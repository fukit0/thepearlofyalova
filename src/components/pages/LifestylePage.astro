---
import Hero from '../Hero.astro';
import Section from '../Section.astro';
import Button from '../Button.astro';
import ResponsiveImage from '../ResponsiveImage.astro';
import { getDictionary, pathFor } from '../../i18n';
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const lifestyle = dict.lifestyle;
---

<Hero
  media="exterior/pool-deck"
  alt={dict.media['exterior/pool-deck']}
  eyebrow={lifestyle.heroEyebrow}
  title={lifestyle.heroTitle}
  lede={lifestyle.heroLede}
/>

<Section width="wide">
  <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-10">
    {
      lifestyle.amenities.map((amenity) => (
        <li class="reveal flex flex-col gap-5">
          <div class="relative aspect-4/3 overflow-hidden rounded-sm bg-sand">
            <ResponsiveImage
              media={amenity.image}
              alt={dict.media[amenity.image] ?? amenity.title}
              sizes="(min-width:1024px) 31vw, (min-width:640px) 46vw, 92vw"
              fill
            />
          </div>
          <div class="flex flex-col gap-2">
            <h2 class="text-xl text-deep">{amenity.title}</h2>
            <p class="text-sm leading-relaxed text-muted">{amenity.body}</p>
          </div>
        </li>
      ))
    }
  </ul>

  <div class="mt-16 flex flex-wrap gap-3">
    <Button href={pathFor('gallery', locale)} variant="ghost">{dict.actions.viewGallery}</Button>
    <Button href={pathFor('residences', locale)}>{dict.actions.viewPlans}</Button>
  </div>
</Section>
