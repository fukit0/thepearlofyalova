---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  align?: 'start' | 'center';
  tone?: 'dark' | 'light';
  class?: string;
}

const { eyebrow, title, lede, align = 'start', tone = 'dark', class: className = '' } = Astro.props;
---

<header
  class:list={[
    'reveal flex flex-col gap-4',
    align === 'center' ? 'items-center text-center' : 'items-start',
    className,
  ]}
>
  {eyebrow && <p class:list={['eyebrow', tone === 'light' && 'text-gold-300']}>{eyebrow}</p>}
  <h2
    class:list={[
      'text-balance text-3xl leading-[1.15] sm:text-4xl lg:text-[2.75rem]',
      tone === 'light' ? 'text-canvas' : 'text-ink',
    ]}
  >
    {title}
  </h2>
  {
    lede && (
      <p
        class:list={[
          'prose-lede max-w-2xl',
          tone === 'light' && 'text-canvas/70',
          align === 'center' && 'mx-auto',
        ]}
      >
        {lede}
      </p>
    )
  }
</header>
