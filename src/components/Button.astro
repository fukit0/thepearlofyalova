---
interface Props {
  href: string;
  /** `outline-light`, koyu görsel üzerinde kullanılır; ghost ile karıştırılmamalı. */
  variant?: 'primary' | 'ghost' | 'light' | 'outline-light';
  external?: boolean;
  class?: string;
}

const { href, variant = 'primary', external = false, class: className = '' } = Astro.props;

const VARIANTS = {
  primary: 'border-deep bg-deep text-canvas hover:border-deep-700 hover:bg-deep-700',
  ghost: 'border-deep/25 bg-transparent text-deep hover:border-deep hover:bg-deep/5',
  light: 'border-transparent bg-canvas text-deep hover:bg-sand',
  'outline-light': 'border-canvas/45 bg-canvas/5 text-canvas backdrop-blur-sm hover:border-canvas hover:bg-canvas/15',
} as const;
---

<a
  href={href}
  rel={external ? 'noopener noreferrer' : undefined}
  target={external ? '_blank' : undefined}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-full border px-6 py-3 text-sm font-medium tracking-wide transition-colors duration-300',
    VARIANTS[variant],
    className,
  ]}
>
  <slot />
</a>
