---
import Logo from './Logo.astro';
import { NAV_PAGES, getDictionary, pathFor } from '../i18n';
import type { Locale } from '../i18n';
import { BRAND, CONTACT, MEDIA_LINKS } from '../data/project';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const year = new Date().getFullYear();
---

<footer class="bg-ink text-canvas/70">
  <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1.2fr]">
      <div class="flex flex-col gap-5">
        <Logo tone="light" />
        <p class="max-w-xs text-sm leading-relaxed">{dict.footer.blurb}</p>
        <a
          href={BRAND.developerUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs tracking-wide text-gold-300 underline-offset-4 hover:underline"
        >
          {dict.footer.developerNote}
        </a>
      </div>

      <nav aria-label={dict.footer.navTitle} class="flex flex-col gap-3">
        <h2 class="text-[0.6875rem] font-semibold tracking-[0.22em] text-canvas/45 uppercase">
          {dict.footer.navTitle}
        </h2>
        {
          NAV_PAGES.map((key) => (
            <a href={pathFor(key, locale)} class="text-sm transition-colors hover:text-canvas">
              {dict.nav[key]}
            </a>
          ))
        }
      </nav>

      <div class="flex flex-col gap-3">
        <h2 class="text-[0.6875rem] font-semibold tracking-[0.22em] text-canvas/45 uppercase">
          {dict.footer.contactTitle}
        </h2>
        <address class="text-sm leading-relaxed not-italic">
          {CONTACT.office.lines.map((line) => <span class="block">{line}</span>)}
        </address>
        <a href={CONTACT.phoneHref} class="text-sm transition-colors hover:text-canvas">
          {CONTACT.phoneDisplay}
        </a>
        <a href={CONTACT.emailHref} class="text-sm transition-colors hover:text-canvas">
          {CONTACT.email}
        </a>
        <a
          href={CONTACT.whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-gold-300 transition-colors hover:text-gold-300/80"
        >
          WhatsApp · {CONTACT.whatsappDisplay}
        </a>
        <a
          href={MEDIA_LINKS.brochureHref}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 inline-flex w-fit items-center gap-2 rounded-full border border-canvas/25 px-4 py-2 text-xs tracking-wide transition-colors hover:border-canvas hover:text-canvas"
        >
          {dict.actions.brochure}
        </a>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-4 border-t border-canvas/10 pt-8 text-xs leading-relaxed text-canvas/45">
      <p class="max-w-3xl">{dict.footer.disclaimer}</p>
      <p>© {year} {BRAND.name} · {BRAND.developer}. {dict.footer.rights}</p>
    </div>
  </div>
</footer>
