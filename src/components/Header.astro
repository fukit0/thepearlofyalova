---
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { NAV_PAGES, getDictionary, pathFor } from '../i18n';
import type { Locale, PageKey } from '../i18n';
import { CONTACT } from '../data/project';

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
const dict = getDictionary(locale);
const homeHref = pathFor('home', locale);
---

<header
  id="site-header"
  data-header
  class="fixed inset-x-0 top-0 z-50 data-[stuck=true]:bg-canvas/92 data-[stuck=true]:shadow-[0_1px_0_rgba(15,61,62,0.12)] data-[stuck=true]:backdrop-blur-lg"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-4 sm:px-8">
    <a href={homeHref} class="shrink-0" aria-label={dict.nav.home}>
      <Logo tone="auto" />
    </a>

    <nav aria-label={dict.nav.home} class="hidden items-center gap-7 lg:flex">
      {
        NAV_PAGES.map((key) => (
          <a
            href={pathFor(key, locale)}
            aria-current={key === page ? 'page' : undefined}
            class="relative text-[0.8125rem] font-medium tracking-wide text-canvas/85 transition-colors hover:text-canvas after:absolute after:-bottom-1.5 after:start-0 after:h-px after:w-0 after:bg-gold-300 after:transition-[width] after:duration-300 hover:after:w-full aria-[current=page]:after:w-full [[data-stuck=true]_&]:text-muted [[data-stuck=true]_&]:hover:text-deep [[data-stuck=true]_&]:after:bg-gold"
          >
            {dict.nav[key]}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <div class="hidden sm:block">
        <LanguageSwitcher page={page} current={locale} label={dict.nav.languages} tone="auto" />
      </div>

      <a
        href={CONTACT.whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden rounded-full border border-canvas/35 px-4 py-2 text-[0.75rem] font-medium tracking-wide text-canvas transition-colors hover:bg-canvas hover:text-deep md:inline-flex [[data-stuck=true]_&]:border-deep/25 [[data-stuck=true]_&]:text-deep [[data-stuck=true]_&]:hover:bg-deep [[data-stuck=true]_&]:hover:text-canvas"
      >
        {CONTACT.phoneDisplay}
      </a>

      <button
        type="button"
        data-menu-open
        aria-controls="mobile-menu"
        aria-expanded="false"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-canvas/30 text-canvas transition-colors lg:hidden [[data-stuck=true]_&]:border-deep/20 [[data-stuck=true]_&]:text-deep"
      >
        <span class="sr-only">{dict.nav.openMenu}</span>
        <svg width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true">
          <path d="M0 1h18M0 6h18M0 11h18" stroke="currentColor" stroke-width="1.4"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<div
  id="mobile-menu"
  data-menu-panel
  hidden
  class="fixed inset-0 z-[60] flex flex-col bg-deep text-canvas lg:hidden"
>
  <div class="flex items-center justify-between px-5 py-4 sm:px-8">
    <Logo tone="light" />
    <button
      type="button"
      data-menu-close
      class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-canvas/30"
    >
      <span class="sr-only">{dict.nav.closeMenu}</span>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.4"></path>
      </svg>
    </button>
  </div>

  <nav class="flex flex-1 flex-col justify-center gap-1 px-5 sm:px-8" aria-label={dict.nav.home}>
    {
      [...NAV_PAGES].map((key, index) => (
        <a
          href={pathFor(key, locale)}
          aria-current={key === page ? 'page' : undefined}
          style={`--i:${index}`}
          class="border-b border-canvas/10 py-4 font-[family-name:var(--font-display)] text-2xl text-canvas/85 transition-colors hover:text-canvas aria-[current=page]:text-gold-300"
        >
          {dict.nav[key]}
        </a>
      ))
    }
  </nav>

  <div class="flex items-center justify-between gap-4 border-t border-canvas/10 px-5 py-6 sm:px-8">
    <LanguageSwitcher page={page} current={locale} label={dict.nav.languages} tone="light" />
    <a href={CONTACT.whatsappHref} target="_blank" rel="noopener noreferrer" class="text-sm text-gold-300">
      {CONTACT.phoneDisplay}
    </a>
  </div>
</div>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  /** Sayfa hero'nun üstündeyken şeffaf, kaydırınca opak. */
  const syncStuck = () => {
    header?.setAttribute('data-stuck', String(window.scrollY > 24));
  };

  syncStuck();
  window.addEventListener('scroll', syncStuck, { passive: true });

  const setMenu = (open: boolean) => {
    if (!panel || !openButton) return;
    panel.hidden = !open;
    openButton.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };

  openButton?.addEventListener('click', () => setMenu(true));
  closeButton?.addEventListener('click', () => setMenu(false));
  panel?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenu(false);
  });
</script>
