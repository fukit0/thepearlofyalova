---
import ResponsiveImage from './ResponsiveImage.astro';

interface Props {
  media: string;
  alt: string;
  eyebrow: string;
  title: string;
  lede?: string;
  /** Ana sayfa tam ekran, iç sayfalar daha kısa. */
  size?: 'full' | 'compact';
  scrollHint?: string;
}

const { media, alt, eyebrow, title, lede, size = 'compact', scrollHint } = Astro.props;

const HEIGHTS = {
  full: 'min-h-[88svh] sm:min-h-[92svh]',
  compact: 'min-h-[58svh] sm:min-h-[62svh]',
} as const;
---

<section class:list={['relative isolate flex items-end overflow-hidden bg-ink', HEIGHTS[size]]}>
  <ResponsiveImage
    media={media}
    alt={alt}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    fill
    class="scale-[1.02]"
  />

  <div class="absolute inset-0" aria-hidden="true">
    <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/45 to-ink/55"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-ink/65 via-ink/10 to-transparent rtl:bg-gradient-to-l"></div>
  </div>

  <div class="relative mx-auto w-full max-w-7xl px-5 pt-32 pb-16 sm:px-8 sm:pb-20">
    <div class="max-w-3xl">
      <p class="eyebrow text-gold-300">{eyebrow}</p>
      <h1
        class:list={[
          'mt-5 text-balance text-canvas',
          size === 'full'
            ? 'text-[2.5rem] leading-[1.06] sm:text-6xl lg:text-7xl'
            : 'text-4xl leading-[1.1] sm:text-5xl lg:text-6xl',
        ]}
      >
        {title}
      </h1>
      {lede && <p class="prose-lede mt-6 max-w-xl text-canvas/75">{lede}</p>}

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <slot />
      </div>
    </div>
  </div>

  {
    scrollHint && (
      <div class="absolute inset-x-0 bottom-6 hidden justify-center sm:flex" aria-hidden="true">
        <span class="flex flex-col items-center gap-2 text-[0.625rem] font-semibold tracking-[0.3em] text-canvas/55 uppercase">
          {scrollHint}
          <svg width="10" height="26" viewBox="0 0 10 26" fill="none">
            <path d="M5 0v22M1 18l4 4 4-4" stroke="currentColor" stroke-width="1.2" />
          </svg>
        </span>
      </div>
    )
  }
</section>
